<?xml version="1.0" encoding="utf-8"?>
<!-- 커스텀 .dna 템플릿: 단일 xll 패킹을 위해 모든 관리 의존성을 Pack="true"로 명시한다.
     (자동 생성 .dna는 ExternalLibrary만 포함해 packed xll에 의존성이 빠짐 — DEV-NOTES 참고) -->
<DnaLibrary Name="WorkReport-AddIn" RuntimeVersion="v4.0" xmlns="http://schemas.excel-dna.net/addin/2020/07/dnalibrary">
  <ExternalLibrary Path="WorkReport.AddIn.dll" ComServer="true" ExplicitExports="false" LoadFromBytes="true" Pack="true" IncludePdb="false" />

  <Reference Path="WorkReport.Core.dll" Pack="true" />
  <Reference Path="ClosedXML.dll" Pack="true" />
  <Reference Path="ClosedXML.Parser.dll" Pack="true" />
  <Reference Path="DocumentFormat.OpenXml.dll" Pack="true" />
  <Reference Path="DocumentFormat.OpenXml.Framework.dll" Pack="true" />
  <Reference Path="ExcelNumberFormat.dll" Pack="true" />
  <Reference Path="Microsoft.Bcl.HashCode.dll" Pack="true" />
  <Reference Path="Newtonsoft.Json.dll" Pack="true" />
  <Reference Path="RBush.dll" Pack="true" />
  <Reference Path="SixLabors.Fonts.dll" Pack="true" />
  <Reference Path="System.Buffers.dll" Pack="true" />
  <Reference Path="System.Memory.dll" Pack="true" />
  <Reference Path="System.Numerics.Vectors.dll" Pack="true" />
  <Reference Path="System.Runtime.CompilerServices.Unsafe.dll" Pack="true" />
</DnaLibrary>
