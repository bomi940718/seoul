<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>WorkReport.AddIn</RootNamespace>
    <UseWPF>true</UseWPF>
    <!-- Excel-DNA: 32/64비트 xll 모두 생성 (실측: 사용자 PC Excel은 x86 — 설치 시 비트 맞는 쪽 사용).
         리본(ComServer)·패킹 참조는 WorkReport-AddIn.dna 템플릿에서 정의 -->
    <ExcelAddInFileName>WorkReport-AddIn</ExcelAddInFileName>
    <!-- ClosedXML 계열의 System.Memory 등 버전 불일치 해소용 .xll.config 생성 -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDna.AddIn" Version="1.9.0" />
    <PackageReference Include="ExcelDna.Interop" Version="15.0.1" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkReport.Core\WorkReport.Core.csproj" />
  </ItemGroup>

  <!-- 자동 생성된 바인딩 리다이렉트(dll.config)를 각 비트 xll 옆에 .xll.config로 복사.
       ExcelDnaPack 타깃이 이를 -packed.xll.config로도 복사한다. -->
  <Target Name="ExcelDnaCopyXllConfig" AfterTargets="ExcelDnaBuild" BeforeTargets="ExcelDnaPack"
          Condition="Exists('$(TargetDir)$(TargetName).dll.config')">
    <Copy SourceFiles="$(TargetDir)$(TargetName).dll.config;$(TargetDir)$(TargetName).dll.config"
          DestinationFiles="$(TargetDir)$(ExcelAddInFileName).xll.config;$(TargetDir)$(ExcelAddInFileName)64.xll.config" />
  </Target>

</Project>
