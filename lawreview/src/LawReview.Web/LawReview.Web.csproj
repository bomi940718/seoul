<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- 화면(HTML/CSS/JS)과 엔진 호출 API를 제공하는 로컬 호스트.
       WebView2 창에서 띄우는 것이 기본이고, 런타임이 없는 PC에서는 같은 주소를
       기본 브라우저로 열어 그대로 쓴다 (LawReview.App 참조). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- 셸(LawReview.App)이 참조해 in-process로 띄우므로 라이브러리로 만든다. -->
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 배포 시 화면 파일이 exe 안에 들어가야 오프라인에서 깨지지 않는다. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- ManifestEmbeddedFileProvider가 내장 파일 목록을 찾으려면 매니페스트 생성이 필요하다. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LawReview.Core\LawReview.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- wwwroot는 단일 exe 배포에서도 읽히도록 어셈블리에 내장한다. -->
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>

</Project>
