<Project Sdk="Microsoft.NET.Sdk">

  <!-- 개발·검증용 콘솔 러너. 배포 대상은 WinForms(LawReview.App)이고,
       이 프로젝트는 실 API 엔드투엔드 실행·회귀 확인에만 쓴다. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- 화면 호스트를 CLI에서 직접 띄우려면(개발 확인용 web 모드) ASP.NET 런타임이 필요하다. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LawReview.Core\LawReview.Core.csproj" />
    <ProjectReference Include="..\LawReview.Web\LawReview.Web.csproj" />
  </ItemGroup>

</Project>
