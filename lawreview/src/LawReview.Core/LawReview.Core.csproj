  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="checklists\*.json" CopyToOutputDirectory="PreserveNewest" />
